# Supabase public browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx

# Server-only Supabase key. NEVER prefix with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Transactional email — server-only, never NEXT_PUBLIC_
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Invoice Chaser <billing@example.com>
# Optional default reply-to; business-level reply-to overrides this when configured.
EMAIL_REPLY_TO=support@example.com

# Protected automation endpoint. Use a random secret of at least 24 characters.
CRON_SECRET=replace_with_a_long_random_secret_at_least_24_chars
